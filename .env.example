# ================= Server =================
PORT=3000
NODE_ENV=development
TZ=Asia/Kolkata
# Local: ngrok URL | Production: Render URL
BASE_URL=https://your-app.onrender.com

# Dashboard jo /api call karega (comma separated origins)
ALLOWED_ORIGINS=http://localhost:5173
# /api/* aur /exotel/outbound ke liye secret (generate: openssl rand -hex 32)
DASHBOARD_API_KEY=change_me

# ================= MongoDB =================
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=ai_receptionist

# ================= Plivo (recommended) =================
# console.plivo.com > Overview: Auth ID / Auth Token
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=918000000000      # aapka Plivo number (country code ke saath, + ke bina)
PLIVO_SAMPLE_RATE=8000               # 8000 (phone line) | 16000
# Stream URL sign karne ka secret (khaali = PLIVO_AUTH_TOKEN use hoga)
# STREAM_SECRET=
# Outbound call voicemail/machine pe lage to turant kaato (paisa bachao)
PLIVO_MACHINE_DETECTION=true
# HUMAN_HANDOFF=true par is number pe <Dial> hoga (khaali = hospitalConfig.hospitalPhone)
# HANDOFF_NUMBER=917408412008

# ================= Exotel (optional — dono saath chal sakte hain) =================
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_PHONE_NUMBER=08047289047
EXOTEL_APP_ID=
# "इंसान से बात" / DTMF 0 par stream band karke flow ke agle applet (Connect) pe bhejo
HUMAN_HANDOFF=false

# ================= LLM =================
# Model IDs apne provider console me VERIFY karo — galat ID = har turn fallback/silence
LLM_PRIMARY=groq            # groq | gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Reasoning models ke liye (model support kare tabhi set karo): none | low
GROQ_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=
# GEMINI_THINKING_LEVEL=minimal
LLM_TEMPERATURE=0.35
# Smooth: LLM stream + pehla vaakya aate hi bolna (false = purana, poora jawab ka intezaar)
LLM_STREAM=true
LLM_MAX_TOKENS=600       # reasoning models (gpt-oss) ke "soch" tokens bhi isme gine jaate hain
# Groq prompt caching (cached input 50% sasta) abhi sirf openai/gpt-oss-20b / gpt-oss-120b par.
# gpt-oss reasoning model hai: GROQ_REASONING_EFFORT=low rakho, warna latency badhegi.
# LOG_LLM_USAGE=true   # har turn ke tokens (aur cached tokens) log me

# ================= STT =================
# groq (Whisper) | sarvam (Saaras — 8 kHz Hindi phone audio pe accha, per-second billing)
# Pehla fail ho to doosra apne aap (dono keys ho to).
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo   # turbo: ~2.7x sasta + tez; Hindi galti badhe to whisper-large-v3
# SARVAM_STT_MODEL=saaras:v3

# ================= TTS =================
# Order = pehle kaun. Jis engine ki key nahi woh skip. Default: sarvam,azure,elevenlabs,edge
TTS_ENGINES=sarvam,azure,elevenlabs,edge
# 1) Sarvam Bulbul (Indian Hindi voice, streaming, sasta) — DEFAULT recommended
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3            # ya bulbul:v4-flash (tez/sasta — speaker naam alag hote hain, docs dekho)
SARVAM_SPEAKER=priya              # v3 female: priya, neha, ritu, pooja, kavya, simran...
SARVAM_PACE=1.0
# 2) Azure Neural (official Microsoft, sasta, 5 lakh chars/month free) — recommended FALLBACK
#    portal.azure.com > Create "Speech service" > region Central India > Keys
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_TTS_VOICE=hi-IN-SwaraNeural
# 3) ElevenLabs (sabse natural, sabse mehenga — premium plan wale hospital ke liye)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_MODEL=eleven_flash_v2_5
# 4) Microsoft Edge (free, UNOFFICIAL endpoint — kabhi bhi band ho sakta hai; sirf fallback)
TTS_VOICE=hi-IN-SwaraNeural
TTS_RATE=-5%
TTS_PITCH=-2Hz
TTS_VOLUME=+5%
# TTS_DISABLE_EDGE=true
# Cache: is se chhote vaakya (characters) apne aap cache => repeat pe 0 cost, 0 latency
TTS_AUTO_CACHE_CHARS=60
TTS_CACHE_MB=40

# ================= Conversation tuning =================
END_OF_TURN_MS=800        # caller chup hone ke kitne ms baad jawab (kam = tez, zyada = beech me nahi katega)
BARGE_IN=true             # caller beech me bole to bot ruke
BARGE_IN_MS=300
FILLER_AFTER_MS=1300      # LLM itna slow ho to "हम्म, एक सेकंड"
IDLE_REPROMPT_MS=7000      # caller chup => itne ms baad "हेलो?" (2 baar ke baad call band)
MAX_REPROMPTS=2
SLOT_CAPACITY=8           # ek shift me ek doctor kitne patient
SLOT_LEAD_MINUTES=30
# Cost guard: isse lambi call politely band (0 = off)
MAX_CALL_SECONDS=420
