# Server
PORT=3000
# Once deployed on Render, set this to your Render URL (e.g. https://ai-receptionist-xxxx.onrender.com)
BASE_URL=https://your-app-name.onrender.com

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# Exotel Telephony
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SID=your_exotel_sid
EXOTEL_PHONE_NUMBER=08047289047

# Google Gemini (Primary high-quota Brain)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (Fast-path Brain & Whisper STT)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

# ElevenLabs (Primary Neural Hindi Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Microsoft Edge Neural (Zero-cost fallback TTS)
TTS_VOICE=hi-IN-SwaraNeural
TTS_RATE=-5%
TTS_PITCH=-2Hz
TTS_VOLUME=+5%
